# Source this file or copy these exports into your shell.
# Do not commit machine-specific secrets here.

export BOOMSLANG_AE_IMAGE=boomslang-ae:local
export JAVA_HEAP=16g
export DOCKER_MEMORY=20g
# Equal to DOCKER_MEMORY means Docker cannot use additional host swap.
export DOCKER_MEMORY_SWAP=20g
export DOCKER_CPUS=12

# reproduce-figXX.sh and smoke-test.sh select their copied data automatically.
# DATA_ROOT is needed only when invoking run-one.sh directly, for example:
# export DATA_ROOT="$PWD/artifacts/data/fig06"
